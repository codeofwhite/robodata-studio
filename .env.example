# Source this file from the Studio repository root after reviewing the paths.
# The public core needs no simulator to start its UI/API and review data.
STUDIO_ROOT="${PWD}"
ROBOT_DATA_STUDIO_WORKSPACE_ROOT="${HOME}/robot-workspace"
NEXT_PUBLIC_STUDIO_API=http://127.0.0.1:8010/api
ROBOT_DATA_STUDIO_DB=${STUDIO_ROOT}/data/studio.db
ROBOT_DATA_STUDIO_DATA_ROOT=${STUDIO_ROOT}/data

# Default: Isaac Panda rigid_cube_lift, Keyboard or GELLO, PhysX.
# Listing the engine does not install its SDK or start a simulation.
ROBOT_DATA_STUDIO_ENABLED_ENGINES=isaac_sim
ROBOT_DATA_STUDIO_ENABLED_EXTENSIONS=
# Bundled worker source. Override explicitly only for an external checkout.
ROBOT_DATA_STUDIO_GELLO_REMOTE_ROOT=${STUDIO_ROOT}/teleop
ROBOT_DATA_STUDIO_ISAACLAB_LAUNCHER=${ROBOT_DATA_STUDIO_WORKSPACE_ROOT}/IsaacLab/isaaclab.sh
ROBOT_DATA_STUDIO_ISAACLAB_CONDA_PREFIX=${ROBOT_DATA_STUDIO_WORKSPACE_ROOT}/.venvs/isaaclab
ROBOT_DATA_STUDIO_PUBLIC_IP=127.0.0.1
ROBOT_DATA_STUDIO_ISAAC_SIGNALING_PORT=49100
ROBOT_DATA_STUDIO_ISAAC_MEDIA_PORT=47998
# Override with your compatible Panda USD if needed. SDK/asset compatibility
# must be checked before collection; the API does not download this asset.
ROBOT_DATA_STUDIO_ISAAC_FRANKA_USD=https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/5.1/Isaac/IsaacLab/Robots/FrankaEmika/panda_instanceable.usd

# Use a separately prepared export environment. No model check runs after export.
ROBOT_DATA_STUDIO_LEROBOT_PYTHON=${ROBOT_DATA_STUDIO_WORKSPACE_ROOT}/.venvs/lerobot/bin/python
# No checkpoint or physical GPU is selected implicitly.
# Optional extension names: genesis,roboverse,cloth,generation,assets,consumer_smokes,offline_render.
# These require their own runtimes and validation; enabling a flag does not install them.
# Genesis/RoboVerse also require selection in ROBOT_DATA_STUDIO_ENABLED_ENGINES.
# offline_render requires the excluded rendering runtime and is unavailable in this draft.
# ROBOT_DATA_STUDIO_ASSET_SOURCES=/absolute/path/to/asset_sources.local.json
# ROBOT_DATA_STUDIO_OPENPI_ROOT=/absolute/path/to/openpi
# ROBOT_DATA_STUDIO_OPENPI_PYTHON=/absolute/path/to/openpi/.venv/bin/python
# ROBOT_DATA_STUDIO_OPENPI_CHECKPOINT=/absolute/path/to/checkpoint
# ROBOT_DATA_STUDIO_OPENPI_GPU_ID=<explicit physical GPU ID>
# ROBOT_DATA_STUDIO_CLOTHFORGE_GPU_ID=<explicit physical GPU ID>
# ROBOT_DATA_STUDIO_CLOTH_GENESIS_GPU_ID=<explicit physical GPU ID>
